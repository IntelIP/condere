# Local configuration template: no credentials are included.
# Fill required bindings; setup scripts update generated local values.

# REQUIRED: required API bindings
# CONDERE_API_URL: required
CONDERE_API_URL=http://127.0.0.1:7778
# CONDERE_API_TOKEN: required
CONDERE_API_TOKEN=
# CONDERE_OWNER_ID: required
CONDERE_OWNER_ID=
# CONDERE_DATABASE_URL: required
CONDERE_DATABASE_URL=
# CONDERE_CHECKPOINT_URL: required
CONDERE_CHECKPOINT_URL=
# CONDERE_EVIDENCE_ENDPOINT: required
CONDERE_EVIDENCE_ENDPOINT=http://127.0.0.1:19000
# CONDERE_EVIDENCE_REGION: required
CONDERE_EVIDENCE_REGION=us-east-1
# CONDERE_EVIDENCE_ACCESS_KEY: required
CONDERE_EVIDENCE_ACCESS_KEY=
# CONDERE_EVIDENCE_SECRET_KEY: required
CONDERE_EVIDENCE_SECRET_KEY=
# CONDERE_EVIDENCE_BUCKET: required
CONDERE_EVIDENCE_BUCKET=condere-evidence
# CONDERE_ARTIFACT_DIRECTORY: required
CONDERE_ARTIFACT_DIRECTORY=.artifacts/assessments
# EXA_API_KEY: required
EXA_API_KEY=
# CONDERE_OPENROUTER_API_KEY: required
CONDERE_OPENROUTER_API_KEY=

# PROVIDER: optional; see docs/configuration.md
# CONDERE_MODEL_PROVIDER: template uses openrouter; runtime default is chatgpt
CONDERE_MODEL_PROVIDER=openrouter
# CONDERE_CHATGPT_HOME: optional
CONDERE_CHATGPT_HOME=
# APIFY_TOKEN: optional
APIFY_TOKEN=
# GITHUB_TOKEN: optional
GITHUB_TOKEN=

# CHATGPT_CLOUD: optional; see docs/configuration.md
# CONDERE_CHATGPT_SECRET: optional
CONDERE_CHATGPT_SECRET=

# SANDBOX: optional; see docs/configuration.md
# CONDERE_SANDBOX: optional
CONDERE_SANDBOX=smol
# CONDERE_SMOL_IMAGE: required when CONDERE_SANDBOX=smol; verified archive or digest
CONDERE_SMOL_IMAGE=

# DATABASE: optional; see docs/configuration.md
# CONDERE_DATABASE_DIRECT_URL: optional
CONDERE_DATABASE_DIRECT_URL=

# EXECUTOR: optional; see docs/configuration.md
# CONDERE_EXECUTOR: optional
CONDERE_EXECUTOR=inprocess
# CONDERE_CLOUD_RUN_JOB: optional
CONDERE_CLOUD_RUN_JOB=

# TRACING: optional; see docs/configuration.md
# LANGSMITH_API_KEY: leave empty to disable tracing
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT: optional
LANGSMITH_PROJECT=
# LANGSMITH_AGENT_ID: optional
LANGSMITH_AGENT_ID=
# LANGSMITH_AGENT_ENVIRONMENT: optional
LANGSMITH_AGENT_ENVIRONMENT=
# LANGSMITH_ENDPOINT: optional
LANGSMITH_ENDPOINT=
# LANGSMITH_WORKSPACE_ID: optional
LANGSMITH_WORKSPACE_ID=

# MCP, sandbox authentication and local storage setup (outside the server contract).
# CONDERE_EXPORT_DIRECTORY: component-specific binding
CONDERE_EXPORT_DIRECTORY=.artifacts/exports
# MODAL_TOKEN_ID: component-specific binding
MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET: component-specific binding
MODAL_TOKEN_SECRET=
# CONDERE_PG_ADMIN_PASSWORD: component-specific binding
CONDERE_PG_ADMIN_PASSWORD=
# CONDERE_DATABASE_PASSWORD: component-specific binding
CONDERE_DATABASE_PASSWORD=
# CONDERE_CHECKPOINT_PASSWORD: component-specific binding
CONDERE_CHECKPOINT_PASSWORD=
